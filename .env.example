# Copy this file to .env for local development.
FLASK_DEBUG=1
SECRET_KEY=replace-this-with-a-long-random-secret

# Local SQLite is the default. For hosted use, set a PostgreSQL URL:
# DATABASE_URL=<paste-your-private-PostgreSQL-connection-string-here>

# Local photos are stored in instance/uploads. For cloud deployment, configure
# Neon Object Storage (S3-compatible) so photos survive deploys.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=club-stock-photos
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=eu-central-1  # use the region displayed by Neon
# S3_PUBLIC_BASE_URL=https://photos.example.org  # optional; leave unset for signed URLs

# Set to 1 in production behind HTTPS.
COOKIE_SECURE=0

# New accounts are created from administrator-issued, single-use invitation links.
